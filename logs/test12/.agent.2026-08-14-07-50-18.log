timestamp=2026-08-13T23:53:05.722Z level=INFO run=9203f28d message=evaluated permission=bash pattern="python3 - << 'EOF'\nCONST_PER_V = 24192.0\ndef vram_model(V, alpha=30.83, beta=-27.0):\n    return CONST_PER_V*V/1e6 + alpha*V/1024.0 + beta\ndef vram_warm(V, alpha=2.8, beta=-27.0):\n    return CONST_PER_V*V/1e6 + alpha*V/1024.0 + beta\nlats = [(16,32,32,32),(16,32,32,64),(20,32,32,64),(24,32,32,64),(24,32,32,32),(32,32,32,32)]\nfor L in lats:\n    V = L[0]*L[1]*L[2]*L[3]\n    c, w = vram_model(V), vram_warm(V)\n    print(f\"{'x'.join(map(str,L)):>14s} V={V:9d}  cold={c:8.1f}MB {c/1024:5.1f}G ({c/(40*1024)*100:5.1f}% of 40G)  warm={w:8.1f}MB {w/1024:5.1f}G ({w/(40*1024)*100:5.1f}% of 40G)\")\nEOF" action.permission=* action.action=allow action.pattern=*
